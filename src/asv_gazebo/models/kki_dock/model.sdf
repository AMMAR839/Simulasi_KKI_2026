<?xml version="1.0"?>
<sdf version="1.9">
  <model name="kki_dock">
    <static>true</static>
    <link name="base_link">
      <visual name="dock_visual">
        <pose>0 0 0.08 0 0 0</pose>
        <geometry>
          <box>
            <size>2.6 0.65 0.16</size>
          </box>
        </geometry>
        <material>
          <ambient>0.45 0.38 0.28 1</ambient>
          <diffuse>0.45 0.38 0.28 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <!-- Dock body is solid for first-contact docking scoring. -->
        <pose>0 0 0.08 0 0 0</pose>
        <geometry>
          <box>
            <size>2.6 0.65 0.16</size>
          </box>
        </geometry>
      </collision>
      <sensor name="object_contact_sensor" type="contact">
        <!-- Dock contacts are published for docking detection and scoring checks. -->
        <contact>
          <collision>collision</collision>
          <topic>/kki/collisions/objects</topic>
        </contact>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>
  </model>
</sdf>
