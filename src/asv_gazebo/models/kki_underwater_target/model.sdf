<?xml version="1.0"?>
<sdf version="1.9">
  <model name="kki_underwater_target">
    <static>true</static>
    <!-- Inverted KKI target box, using the simple box primitive pattern from:
         /home/ammar/Documents/asv_simulation/asv_wave_sim/gz-waves-models/models/shipping_container
         Blue is above the waterline and green is below it. -->
    <link name="base_link">
      <visual name="blue_box_above_water">
        <cast_shadows>true</cast_shadows>
        <pose>0 0 0.150 0 0 0</pose>
        <geometry>
          <box>
            <size>0.60 0.60 0.30</size>
          </box>
        </geometry>
        <material>
          <ambient>0.00 0.18 0.95 1</ambient>
          <diffuse>0.00 0.18 0.95 1</diffuse>
          <emissive>0.00 0.03 0.18 1</emissive>
        </material>
      </visual>
      <visual name="green_box_under_water">
        <cast_shadows>false</cast_shadows>
        <pose>0 0 -0.300 0 0 0</pose>
        <geometry>
          <box>
            <size>0.60 0.60 0.60</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.95 0.10 0.92</ambient>
          <diffuse>0.0 0.95 0.10 0.92</diffuse>
          <emissive>0.0 0.18 0.02 1</emissive>
        </material>
      </visual>
      <visual name="waterline_lip_front">
        <cast_shadows>false</cast_shadows>
        <pose>0 0.320 0.008 0 0 0</pose>
        <geometry>
          <box>
            <size>0.64 0.030 0.016</size>
          </box>
        </geometry>
        <material>
          <ambient>0.02 0.08 0.08 1</ambient>
          <diffuse>0.02 0.08 0.08 1</diffuse>
        </material>
      </visual>
      <visual name="waterline_lip_back">
        <cast_shadows>false</cast_shadows>
        <pose>0 -0.320 0.008 0 0 0</pose>
        <geometry><box><size>0.64 0.030 0.016</size></box></geometry>
        <material><ambient>0.02 0.08 0.08 1</ambient><diffuse>0.02 0.08 0.08 1</diffuse></material>
      </visual>
      <visual name="waterline_lip_left">
        <cast_shadows>false</cast_shadows>
        <pose>-0.320 0 0.008 0 0 0</pose>
        <geometry><box><size>0.030 0.64 0.016</size></box></geometry>
        <material><ambient>0.02 0.08 0.08 1</ambient><diffuse>0.02 0.08 0.08 1</diffuse></material>
      </visual>
      <visual name="waterline_lip_right">
        <cast_shadows>false</cast_shadows>
        <pose>0.320 0 0.008 0 0 0</pose>
        <geometry><box><size>0.030 0.64 0.016</size></box></geometry>
        <material><ambient>0.02 0.08 0.08 1</ambient><diffuse>0.02 0.08 0.08 1</diffuse></material>
      </visual>
      <collision name="collision">
        <!-- Full inverted surveillance box collision: 60 x 60 x 90 cm. -->
        <pose>0 0 -0.150 0 0 0</pose>
        <geometry>
          <box>
            <size>0.60 0.60 0.90</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
