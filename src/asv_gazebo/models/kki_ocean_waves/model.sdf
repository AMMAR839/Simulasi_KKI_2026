<?xml version='1.0' ?>
<sdf version="1.6">
  <model name="kki_ocean_waves">
    <static>true</static>
    <!-- Adapted from:
         /home/ammar/Documents/asv_simulation/asv_wave_sim/gz-waves-models/world_models/ocean_waves
         Uses the gz-waves Harmonic plugins copied into this workspace. -->

    <plugin
        filename="gz-waves1-waves-model-system"
        name="gz::sim::systems::WavesModel">
      <static>0</static>
      <update_rate>30</update_rate>
      <wave>
        <!-- `fft` wave parameters -->
        <algorithm>fft</algorithm>
        <tile_size>30</tile_size>
        <cell_count>256</cell_count>
        <wind_speed>2.0</wind_speed>
        <wind_angle_deg>135</wind_angle_deg>
        <amplitude>0.025</amplitude>
        <period>3.5</period>
        <scale>1.0</scale>
        <steepness>0.55</steepness>
      </wave>
    </plugin>

    <link name="base_link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>materials/mesh_L30m_N256.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.00 0.18 0.34 0.95</ambient>
          <diffuse>0.00 0.30 0.50 0.95</diffuse>
          <specular>0.45 0.62 0.70 1.0</specular>
        </material>

        <!-- \todo remove duplicate params; populate from service instead -->
        <plugin
            filename="gz-waves1-waves-visual-system"
            name="gz::sim::systems::WavesVisual">
          <static>0</static>
          <mesh_deformation_method>DYNAMIC_GEOMETRY</mesh_deformation_method>
          <tiles_x>0 0</tiles_x>
          <tiles_y>0 0</tiles_y>
          <wave>
            <!-- `fft` wave parameters -->
            <algorithm>fft</algorithm>
            <tile_size>30</tile_size>
            <cell_count>256</cell_count>
            <wind_speed>2.0</wind_speed>
            <wind_angle_deg>135</wind_angle_deg>
            <amplitude>0.025</amplitude>
            <period>3.5</period>
            <scale>1.0</scale>
            <steepness>0.55</steepness>
          </wave>

          <!-- shader program -->
          <shader language="glsl">
            <vertex>materials/waves_vs.glsl</vertex>
            <fragment>materials/waves_fs.glsl</fragment>
          </shader>
          <shader language="metal">
            <vertex>materials/waves_vs.metal</vertex>
            <fragment>materials/waves_fs.metal</fragment>
          </shader>

          <!-- vertex shader params -->
          <param>
            <shader>vertex</shader>
            <name>world_matrix</name>
          </param>
          <param>
            <shader>vertex</shader>
            <name>worldviewproj_matrix</name>
          </param>
          <param>
            <shader>vertex</shader>
            <name>camera_position</name>
          </param>
          <param>
            <shader>vertex</shader>
            <name>rescale</name>
            <value>0.28</value>
            <type>float</type>
          </param>
          <param>
            <shader>vertex</shader>
            <name>bumpScale</name>
            <value>40 40</value>
            <type>float_array</type>
          </param>
          <param>
            <shader>vertex</shader>
            <name>bumpSpeed</name>
            <value>0.003 0.002</value>
            <type>float_array</type>
          </param>
          <param>
            <shader>vertex</shader>
            <name>t</name>
            <value>TIME</value>
          </param>

          <!-- pixel shader params -->
          <param>
            <shader>fragment</shader>
            <name>deepColor</name>
            <value>0.0 0.12 0.30 1.0</value>
            <type>float_array</type>
          </param>
          <param>
            <shader>fragment</shader>
            <name>shallowColor</name>
            <value>0.0 0.32 0.50 1.0</value>
            <type>float_array</type>
          </param>
          <param>
            <shader>fragment</shader>
            <name>fresnelPower</name>
            <value>5.0</value>
            <type>float</type>
          </param>
          <param>
            <shader>fragment</shader>
            <name>hdrMultiplier</name>
            <value>0.65</value>
            <type>float</type>
          </param>
          <param>
            <shader>fragment</shader>
            <name>bumpMap</name>
            <value>materials/wave_normals.dds</value>
            <type>texture</type>
            <arg>0</arg>
          </param>
          <param>
            <shader>fragment</shader>
            <name>cubeMap</name>
            <value>materials/skybox_lowres.dds</value>
            <type>texture_cube</type>
            <arg>1</arg>
          </param>

        </plugin>
      </visual>

      <visual name="visual_below">
        <pose>0 0 -0.01 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>materials/mesh_L30m_N256_below.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.0 0.05 0.18 0.55</ambient>
          <diffuse>0.0 0.10 0.26 0.55</diffuse>
          <specular>0.25 0.35 0.38 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
