<?xml version="1.0"?>
<sdf version="1.9">
  <model name="kki_obstacle_yellow">
    <static>true</static>
    <link name="base_link">
      <visual name="obstacle_visual">
        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.70</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.0 0.76 0.02 1</ambient>
          <diffuse>1.0 0.76 0.02 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <!-- Cylindrical collision follows the obstacle visual so hit detection
             happens on the round obstacle body, not a square proxy. -->
        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.70</length>
          </cylinder>
        </geometry>
      </collision>
      <sensor name="object_contact_sensor" type="contact">
        <!-- Object-side contact catches obstacle hits even if the hull sensor misses one frame. -->
        <contact>
          <collision>collision</collision>
          <topic>/kki/collisions/objects</topic>
        </contact>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>
  </model>
</sdf>
