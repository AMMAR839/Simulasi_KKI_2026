<?xml version="1.0"?>
<sdf version="1.9">
  <model name="kki_start_finish_marker">
    <static>true</static>
    <link name="base_link">
      <visual name="start_finish_visual">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>1.0</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.45 1.0 1</ambient>
          <diffuse>0.02 0.45 1.0 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <!-- Thin marker collision keeps the start/finish object detectable
             without acting like a tall obstacle. -->
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>1.0</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
