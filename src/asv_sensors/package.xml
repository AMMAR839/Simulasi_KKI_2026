<?xml version="1.0"?>
<package format="3">
  <name>asv_sensors</name>
  <version>0.1.0</version>
  <description>Sensor bridge configuration and health monitor for ASV simulation.</description>
  <maintainer email="ammar@example.com">ammar</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
