<?xml version="1.0"?>
<package format="3">
  <name>asv_navigation</name>
  <version>0.1.0</version>
  <description>GPS waypoint follower and navigation configuration for ASV simulation.</description>
  <maintainer email="ammar@example.com">ammar</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>opennav_docking</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
