<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="asv_kki_2026">
  <xacro:property name="mass" value="7.2"/>
  <xacro:property name="loa" value="0.831"/>
  <xacro:property name="beam" value="0.574"/>
  <xacro:property name="height" value="0.474"/>
  <xacro:property name="draft" value="0.110"/>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m * (y*y + z*z) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${m * (x*x + z*z) / 12.0}"
        iyz="0.0"
        izz="${m * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <material name="thruster_black">
    <color rgba="0.015 0.015 0.015 1.0"/>
  </material>
